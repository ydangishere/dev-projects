# ---- Language model (LiteLLM model string). Empty = offline mode, no model called. ----
# Self-hosted Qwen via Ollama (documents stay inside the bank):
# LLM_MODEL=ollama_chat/qwen2.5:7b
# LLM_API_BASE=http://localhost:11434
# Through the bank's LiteLLM proxy (rate limits, keys, fallbacks in one place):
# LLM_MODEL=litellm_proxy/copilot-default
# LLM_API_BASE=http://localhost:4000
# LLM_API_KEY=sk-change-me
# Google Gemini:
# LLM_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=90
# LLM_FALLBACK_MODEL=

# Policy Điều 7.2: document text is sent to the model only when this is true
# (still masked: ID numbers, account numbers and names become placeholders).
LLM_SEND_DOCUMENTS=false

# ---- Llama Guard safety classifier (optional) ----
# GUARD_MODEL=ollama_chat/llama-guard3:1b
# GUARD_API_BASE=http://localhost:11434

# ---- PII masking: auto (Presidio if installed) | regex ----
PII_ENGINE=auto
# PII_SPACY_MODEL=xx_ent_wiki_sm

# ---- Langfuse tracing (optional) ----
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# AUDIT_PATH=data/audit.jsonl
