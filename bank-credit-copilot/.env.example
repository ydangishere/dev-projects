# offline (default, no model) | gemini | openai (any OpenAI-compatible server, e.g. on-prem vLLM/Ollama)
LLM_PROVIDER=offline

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Policy Điều 7.2: document text is NOT sent to the model unless this is true.
# Without it, the model only rewrites the memo from masked, pre-computed facts.
LLM_SEND_DOCUMENTS=false

# AUDIT_PATH=data/audit.jsonl
