# offline (default, rule-based only) | gemini | openai (any OpenAI-compatible server, e.g. on-prem vLLM/Ollama)
# The LLM is called only for messages the rule parser cannot understand.
LLM_PROVIDER=offline

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Show the OTP in a fake "SMS" pop-up so the demo can be completed in the browser.
DEMO_SHOW_OTP=true

# Call the core-banking API over HTTP instead of in-process (e.g. http://127.0.0.1:8000).
# CORE_BASE_URL=

# AUDIT_PATH=data/audit.jsonl
