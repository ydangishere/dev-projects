# Copy to .env. Never commit real credentials.
DATABASE_PATH=./workspace/agent.sqlite3
PROJECT_ROOT=./workspace/site
REQUIREMENTS_URL=
FIGMA_URL=https://www.figma.com/design/pWBOixkuMBfbJrkCQphPaJ/Vietpay-website-project--Copy-?node-id=2063-71
GITHUB_DEMO_URL=
# Model calls (optional; without keys you can save/import concepts manually)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# SMTP for sending emails; e.g., Google Workspace SMTP relay or Gmail app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Google Chat incoming webhook to a space you administer (optional)
GOOGLE_CHAT_WEBHOOK=
# Safety: no external messages unless explicitly enabled in the UI.
