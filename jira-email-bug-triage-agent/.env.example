# Default: offline, safe, synthetic sample data
SOURCE_MODE=mock
ENABLE_AI=false
# Optional: use OpenAI ONLY with redacted ticket/email excerpts and explicit approval
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=never_commit_secrets
# Jira Cloud: enable only when user chooses SOURCE_MODE=jira or both
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=replace_me
# JIRA_JQL=issuetype in (Bug, Incident) ORDER BY updated DESC
# Gmail readonly token JSON created locally by OAuth: not included in repository
# GMAIL_TOKEN_FILE=/secure/path/to/gmail-token.json
# GMAIL_QUERY=(bug OR incident OR error) newer_than:30d
