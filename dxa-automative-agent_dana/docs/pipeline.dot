// DXA Dana — 2 workflows: /ask (fixed) and /diagnose (bounded Agentic).
// Render: dot -Tpng -Gdpi=160 docs/pipeline.dot -o docs/pipeline.png
digraph DXA {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", fontsize=17, nodesep=.48, ranksep=.65, pad=.45, compound=true];
  node [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#0E233D", margin=".2,.13"];
  edge [fontname="DejaVu Sans", fontsize=11, color="#106A84", fontcolor="#0E233D"];

  subgraph cluster_kb {
    label="1. Prepare verified knowledge"; style="rounded,filled"; fillcolor="#EDF3F9"; color="#BBCFDF";
    VIDEO [label="YouTube video\nand transcripts"];
    EXTRACT [label="Extract symptoms,\ncauses, checks, fixes"];
    REVIEW [label="Mechanic reviews cases", fillcolor="#DDF0E4"];
    INDEX [label="BM25 + Vector / Qdrant\nGraph + SQLite + JSON"];
    VIDEO -> EXTRACT -> REVIEW -> INDEX;
  }

  subgraph cluster_ui {
    label="2. UI and API"; style="rounded,filled"; fillcolor="#F0F6FB"; color="#BBCFDF";
    UI [label="Web UI\nAsk / Agentic / Expert"];
    API [label="FastAPI\n/ask | /diagnose"];
    UI -> API;
  }

  subgraph cluster_dana {
    label="3. Dana Agent Orchestration"; style="rounded,filled"; fillcolor="#E9F5F9"; color="#106A84";
    MODE [label="Workflow mode?",shape=diamond, fillcolor="#FFE5AA"];
    CLASSIC [label="Fixed /ask\nfind_cases -> gate -> write_answer -> check"];
    PLAN [label="Planner (Dana + LLM)\nChoose permitted action", fillcolor="#D7EDF6"];
    TOOL [label="Tool selection\nask_user | search_rag | answer | handoff"];
    MEMORY [label="Session Memory (SQLite)\nSymptoms, evidence, queries"];
    EVAL [label="Evaluate evidence / limits",shape=diamond,fillcolor="#FFE5AA"];
    REPLAN [label="Replanning (ask model again)\nwith updated state",fillcolor="#D7EDF6"];
    FINAL [label="Grounded answer with source\nor handoff to mechanic", fillcolor="#DDF0E4"];
    MODE -> CLASSIC -> FINAL;
    MODE -> PLAN -> TOOL -> MEMORY -> EVAL;
    EVAL -> REPLAN [label="insufficient"];
    REPLAN -> PLAN [constraint=false];
    EVAL -> FINAL [label="enough / stop"];
  }

  subgraph cluster_expert {
    label="4. Mechanic feedback (authenticated)"; style="rounded,filled"; fillcolor="#EDF7F0"; color="#539173";
    PENDING [label="Unanswered questions"];
    ADD [label="Mechanic adds or rejects case"];
    PENDING -> ADD;
  }

  INDEX -> CLASSIC [lhead=cluster_dana];
  INDEX -> TOOL [label="RAG tool", lhead=cluster_dana];
  API -> MODE;
  FINAL -> UI [constraint=false];
  FINAL -> PENDING [style=dashed, label="no evidence"];
  ADD -> INDEX [style=dashed, label="reindex", constraint=false];
}
