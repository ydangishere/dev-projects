        DRAFT["Tạo câu trả lời<br/>chỉ từ case / video có nguồn"]
        VALIDATE{"Validation<br/>Nguồn, mã case, số liệu, giới hạn an toàn?"}
        PASS["Trả lời có dẫn nguồn<br/>và lưu Memory"]
        PLAN["Planner / Replanner<br/>Chọn bước tiếp theo theo state mới"]
        NEXT{"Cần làm gì tiếp?"}
        ASK["Ask User<br/>Hỏi thêm triệu chứng"]
        MEM["Memory<br/>Lưu dữ kiện mới"]
        SEARCH["Search Again<br/>Đổi truy vấn, lọc case"]
        STOP{"Còn trong giới hạn<br/>lượt hỏi / truy vấn / thời gian?"}
