        ENTRY --> RETRIEVE --> GATE
        GATE -->|Đủ| DRAFT --> VALIDATE
        VALIDATE -->|Đạt| PASS
        GATE -->|Thiếu / không liên quan| PLAN
        VALIDATE -->|Không đạt| PLAN
        PLAN --> STOP
        STOP -->|Không| HANDOFF
        STOP -->|Có| NEXT
        NEXT -->|Thiếu triệu chứng| ASK --> MEM --> ENTRY
        NEXT -->|Cần tài liệu khác| SEARCH --> RETRIEVE
        NEXT -->|Không có hướng an toàn| HANDOFF
    end

    RAG["TẦNG 6 · RAG TOOL<br/>BM25 + Vector + RRF"]
    DATA[("TẦNG 7 · DATABASE<br/>Case / transcript / video nguồn / SQLite")]
