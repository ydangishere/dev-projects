# DXA viết bằng Dana: agent thợ sửa xe máy.
#
# Luồng một câu hỏi (workflow wf_answer):
#   find_cases   tìm case + đoạn video (Python: BM25 + vector, dùng lại rag.py)
#   gate         ngoài phạm vi thì từ chối, không gọi LLM, không đoán
#   write_answer reason() viết câu trả lời theo cấu trúc RepairAnswer
#   check        kiểm chống bịa: số lạ, mã case lạ -> bỏ câu của LLM, dùng câu ghép khuôn
#
# Chạy thử:      dana dxa_agent.na question="binh xang con chay xang"
# Đưa lên API:   dana deploy dxa_agent.na

import dxa_tools.py as tools

struct RepairAnswer:
    benh: str
    nguyen_nhan: str
    cac_buoc: list
    thong_so: list
    luu_y: str
    ma_case: list

agent_blueprint DXAMechanic:
    name: str = "DXA"
    description: str = "Trợ lý sửa xe máy, trả lời từ 30 video kênh y dang"
    domain: str = "Sửa xe máy"


def find_cases(job: dict) -> dict:
    r = tools.retrieve(job["question"])
    job["query_used"] = r["query_used"]
    job["in_scope"] = r["in_scope"]
    job["near"] = r["near"]
    job["case_ids"] = r["case_ids"]
    job["case_idx"] = r["case_idx"]
    job["context"] = r["context"]
    job["sources"] = r["sources"]
    return job


def gate(job: dict) -> dict:
    # Có nguồn (video) thì phải có câu trả lời bằng chữ; từ chối thì không kèm nguồn.
    job["refused"] = False
    if job["in_scope"]:
        return job
    if job["near"]:
        tools.log_unanswered(job["question"], job["query_used"], "gần đúng")
        return job
    job["refused"] = True
    job["answer"] = tools.refuse_text()
    job["answered_by"] = "gate"
    job["sources"] = []
    tools.log_unanswered(job["question"], job["query_used"], "ngoài phạm vi")
    return job


def write_answer(job: dict) -> dict:
    if job["refused"]:
        return job
    if not tools.llm_ready():
        job["answer"] = tools.template_answer(job["case_idx"])
        job["answered_by"] = "template"
        return job
    raw = reason(tools.answer_prompt(job["query_used"], job["context"]), temperature=0.2)
    d = tools.parse_answer(raw)
    if len(d) == 0:
        job["warnings"] = job["warnings"] + ["Câu của LLM không đúng dạng JSON, dùng câu ghép khuôn"]
        job["answer"] = tools.template_answer(job["case_idx"])
        job["answered_by"] = "template"
        return job
    if "khong_du_thong_tin" in d:
        job["refused"] = True
        job["sources"] = []
        job["answer"] = tools.refuse_text()
        job["answered_by"] = "llm"
        tools.log_unanswered(job["question"], job["query_used"], "LLM: ngữ cảnh không đủ")
        return job
    ans = RepairAnswer(benh=d["benh"], nguyen_nhan=d["nguyen_nhan"], cac_buoc=d["cac_buoc"], thong_so=d["thong_so"], luu_y=d["luu_y"], ma_case=d["ma_case"])
    job["structured"] = d
    job["answer"] = tools.render_answer(d)
    job["answered_by"] = "llm"
    job["n_steps"] = len(ans.cac_buoc)
    return job


def check(job: dict) -> dict:
    if job["answered_by"] != "llm" or job["refused"]:
        return job
    problems = tools.check_answer(job["answer"], job["context"], job["question"], job["case_ids"])
    if len(problems) > 0:
        for p in problems:
            job["warnings"] = job["warnings"] + [f"Câu của LLM bị loại: {p}"]
        job["answer"] = tools.template_answer(job["case_idx"])
        job["answered_by"] = "template"
    return job


def wf_answer(job) = find_cases | gate | write_answer | check


def ask(question: str) -> dict:
    job = wf_answer({"question": question, "warnings": [], "answered_by": "", "mode": tools.mode()})
    out = {"question": question, "query_used": job["query_used"], "answer": job["answer"]}
    out["refused"] = job["refused"]
    out["near"] = job["near"] and not job["refused"]
    out["answered_by"] = job["answered_by"]
    out["mode"] = job["mode"]
    out["warnings"] = job["warnings"]
    out["sources"] = job["sources"]
    return out


def (mechanic: DXAMechanic) solve(problem: str, context: dict = None, resources: list = None, workflows: list = None) -> str:
    r = ask(problem)
    text = r["answer"]
    if not r["refused"]:
        text = text + "\n\nXem video:"
        for src in r["sources"]:
            if src["type"] == "case":
                text = text + f"\n  [{src['id']}] {src['video_title']} ({src['time']}): {src['link']}"
    return text


# Agent dùng cho `dana deploy dxa_agent.na` (REST: POST /solve {"query": "..."})
dxa = DXAMechanic()


def __main__(question: str = "Bình xăng con chảy xăng khi dựng xe"):
    print(f"Hỏi: {question}")
    print(dxa.solve(question))


# ---------------------------------------------------------------- Optional agentic diagnostic mode
# Unlike wf_answer, the decision below is chosen by the LLM on every turn.
# Python diagnostic.py enforces finite loops and retains memory across requests.

def plan_diagnostic(context_json: str) -> dict:
    if not tools.llm_ready():
        return {"action": "handoff"}
    raw = reason(tools.planning_prompt(context_json), temperature=0.1)
    return tools.parse_plan(raw)


def answer_diagnostic(question: str, context: str, case_ids: list, sources: list, case_idx: list) -> dict:
    if not case_ids:
        return {"refused": True, "answer": tools.refuse_text(), "sources": [], "warnings": ["Không có case"]}
    if not tools.llm_ready():
        return {"refused": True, "answer": tools.refuse_text(), "sources": [], "warnings": ["Chưa cấu hình LLM"]}
    raw = reason(tools.answer_prompt(question, context), temperature=0.2)
    parsed = tools.parse_answer(raw)
    if len(parsed) == 0 or "khong_du_thong_tin" in parsed:
        return {"refused": True, "answer": tools.refuse_text(), "sources": [], "warnings": ["LLM: thiếu bằng chứng hoặc JSON sai"]}
    text = tools.render_answer(parsed)
    problems = tools.check_answer(text, context, question, case_ids)
    if len(problems) > 0:
        return {"refused": True, "answer": tools.refuse_text(), "sources": [], "warnings": problems}
    return {"refused": False, "answer": text, "sources": sources, "warnings": []}
