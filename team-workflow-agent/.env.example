# Local development only. Never commit .env or real tokens.
DATABASE_PATH=./workspace/workflow.sqlite3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# SMTP outgoing email; action required to send queued notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CHAT_WEBHOOK=
# Optional Google Sheets mirror; sheet named Modules must already exist
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Modules
# Optional Figma read-only text context
FIGMA_TOKEN=
# Optional GitHub Issue creation
GITHUB_REPOSITORY=ydangishere/dev-projects
GITHUB_TOKEN=
