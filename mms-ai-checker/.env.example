# demo | gemini | qwen
AI_MODE=demo
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Policy retrieval embeddings:
#   local     - default, offline hashed n-grams (spelling overlap, not meaning)
#   fastembed - offline multilingual semantic model; pip install -r requirements-semantic.txt
#   gemini    - Gemini embedding API; sends policy text and the employee question to Gemini
EMBED_MODE=local
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# FASTEMBED_CACHE_PATH=runtime/models
GEMINI_EMBED_MODEL=gemini-embedding-001
# Qwen through any OpenAI-compatible endpoint (local Ollama by default).
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen3.5:9b
QWEN_API_KEY=
QWEN_TIMEOUT=120
# "none" disables Qwen thinking; set empty for servers that reject reasoning_effort.
QWEN_REASONING_EFFORT=none
# Policy embedding index: memory (default) | pgvector (pip install -r requirements-vector.txt)
VECTOR_STORE=memory
# PGVECTOR_DSN=postgresql://USER:PASSWORD@127.0.0.1:5432/mms
# Optional LangSmith tracing (pip install -r requirements-observability.txt).
# Only question, tenant, review date, rule IDs, scores and chunk IDs are sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=mms-ai-checker
# Set explicit server-side principals before any non-local use. JSON, never send to Gemini.
# TOKENS_JSON={"LONG_RANDOM_TOKEN":{"user":"checker1","tenant":"pvcb","role":"checker"}}
TOKENS_JSON=
APP_ENV=development
# Login: tokens (TOKENS_JSON / demo tokens) | oidc (bank SSO, signed JWT access tokens)
AUTH_MODE=tokens
# OIDC_ISSUER=https://idp.bank.example/realms/mms
# OIDC_AUDIENCE=mms-ai-checker
# OIDC_JWKS_URL=https://idp.bank.example/realms/mms/protocol/openid-connect/certs
# OIDC_ALLOWED_TENANTS=pvcb
# OIDC_ROLE_MAP={"mms-makers":"maker","mms-checkers":"checker","mms-viewers":"viewer"}
# OIDC_ROLE_CLAIM=groups
# OIDC_TENANT_CLAIM=tenant
# OIDC_USER_CLAIM=preferred_username
# Encryption at rest for application bodies, documents, checks and investigations.
# Create with: python scripts/rotate_keys.py --new-key   (required when APP_ENV=production)
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_OLD_KEYS=
# Upload malware scanning: off | clamd (required when APP_ENV=production)
MALWARE_SCAN=off
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
# Prometheus metrics at /metrics; disabled while empty. Scrape with this bearer token.
METRICS_TOKEN=
# Transaction investigation data: mock (synthetic; refused in production) | http
BANK_MODE=mock
# BANK_API_URL=https://bank-api.example/
# BANK_API_TOKEN=
DATA_DIR=runtime
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Module 1: local graph retrieval works without external services.
# For persistent graph queries: pip install -r requirements-graph.txt
GRAPH_BACKEND=local
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Must be a unique secret with >=32 characters; never commit the real value.
GRAPH_HMAC_KEY=
