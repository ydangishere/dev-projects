AI_MODE=demo
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Set explicit server-side principals before any non-local use. JSON, never send to Gemini.
# TOKENS_JSON={"LONG_RANDOM_TOKEN":{"user":"checker1","tenant":"pvcb","role":"checker"}}
TOKENS_JSON=
APP_ENV=development
DATA_DIR=runtime
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Module 1: local graph retrieval works without external services.
# For persistent graph queries: pip install -r requirements-graph.txt
GRAPH_BACKEND=local
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Must be a unique secret with >=32 characters; never commit the real value.
GRAPH_HMAC_KEY=
