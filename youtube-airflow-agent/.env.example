# URL of a YouTube channel. Supports https://www.youtube.com/@handle or /channel/UC...
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@ydang7076
# Create an unrestricted-for-development YouTube Data API v3 key, then restrict it to this API
YOUTUBE_API_KEY=
# BotFather token, start a chat with your bot first; never share bot token publicly
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: AI classifies and suggests replies when this key is set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Send notifications for all new public comments, even if not questions
NOTIFY_ALL_COMMENTS=true
# Number of newest comment-thread pages fetched per polling run (100 per page)
MAX_PAGES=3
# First execution includes up to 12 hours of recent comments; avoids sending entire historic backlog
INITIAL_LOOKBACK_MINUTES=720
